<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude all app-private data from automatic cloud backup and device transfer.
    Explicit business backup/restore remains available through the validated app flow.
    See https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
